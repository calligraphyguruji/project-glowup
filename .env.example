# ==============================================================================
# RepoDoctor AI (StackFit AI) - Environment Variables Configuration
# Copy this file to .env.local for local development.
# NEVER commit actual secrets, keys, or .env.local to version control.
# ==============================================================================

# Google Gemini API Key (Required for AI code audit and architecture generation)
# Obtain a free-tier API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model ID (Defaults to gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# GitHub Personal Access Token (Optional for development, Recommended for higher rate limits)
# Without a token: 60 requests/hr per IP.
# With token (public_repo / read-only scope): 5,000 requests/hr.
GITHUB_TOKEN=your_github_personal_access_token_here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Rate Limiting & Safety Controls (In-memory token bucket per client IP)
MAX_FILES_PER_AUDIT=10
MAX_FILE_SIZE_BYTES=51200
REQUESTS_PER_MINUTE_LIMIT=15
